<launch>

<rosparam file="$(find avt_head_ind_v1_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="avt_head_ind_v1" args="head_pan_position_controller head_tilt_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/avt_head_ind_v1/joint_states"/>
</node>

</launch>